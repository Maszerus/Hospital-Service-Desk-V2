{
  "name": "medidesk",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalny demonstracyjny szpitalny Service Desk",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "lab:csrf": "node lab/csrf-server.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js --reset",
    "test": "node --test tests/server.test.js",
    "format": "prettier --write public lab scripts tests config routes controllers services repositories middleware server.js database.js README.md package.json package-lock.json .prettierrc.json"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-session": "^1.19.0"
  }
}
